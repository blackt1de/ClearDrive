"""Send the backend's exact /api/chat body (copied from ollama_client.ask_ollama,
no `think` key) for one captured prompt; report where thinking lands and the budget."""
import json, sys, re, httpx, time
d = json.load(open(sys.argv[1])); model = sys.argv[2]
t = time.time()
r = httpx.post("http://localhost:11434/api/chat", timeout=600, json={
    "model": model, "stream": False,
    "messages": [{"role": "system", "content": d["system"]}, {"role": "user", "content": d["user"]}],
    "options": {"temperature": 0.2, "num_predict": 2800, "num_ctx": 16384,
                "repeat_penalty": 1.15, "repeat_last_n": 256}}).json()
m = r.get("message", {}); c = m.get("content", ""); th = m.get("thinking") or ""
print("wall_s", round(time.time() - t, 1), "prompt_eval_count", r.get("prompt_eval_count"),
      "eval_count", r.get("eval_count"), "done_reason", r.get("done_reason"))
print("thinking_field_chars", len(th), "content_chars", len(c), "<think> in content:", "<think>" in c)
print("headers in content:", re.findall(r"^([A-Z][A-Z' ]{3,}):", c, re.M))
print("---content head---"); print(c[:600])
