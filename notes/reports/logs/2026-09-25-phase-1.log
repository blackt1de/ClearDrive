"""Capture the exact user prompt /interpret builds for every fixture.
Model call stubbed, DB writes stubbed; retrieval runs for real (it is part of
the prompt). Writes one JSON per fixture: {name, system, user}."""
import asyncio, json, sys
from pathlib import Path
from unittest.mock import patch
sys.path.insert(0, "/home/abrennan/cleardrive")
import main, fixtures, ollama_client
out = Path(sys.argv[1]); out.mkdir(parents=True, exist_ok=True)
captured = {}
async def fake_model(prompt, model=None):
    captured["user"] = prompt
    return "SAFETY LEVEL: SAFE"
for s in fixtures.list_scenarios():
    name = s["name"]; captured.clear()
    with patch.object(main, "ask_ollama", fake_model), \
         patch.object(main, "log_scan", lambda *a, **k: -1), \
         patch.object(main, "log_research_scan", lambda *a, **k: -1):
        asyncio.run(main.interpret(main.InterpretRequest(scenario=name)))
    (out / f"{name}.json").write_text(json.dumps(
        {"name": name, "system": ollama_client.SYSTEM_PROMPT, "user": captured.get("user")}))
    print(name, len(captured.get("user") or ""), "chars")
----
"""Token count per captured prompt, using the served model's own tokenizer:
Ollama /api/chat prompt_eval_count with num_predict=1 (system+user, chat template
included). The largest prompt is sent first and again last to detect prefix-cache
effects on the count."""
import json, sys, httpx
from pathlib import Path
model = sys.argv[2]
ps = sorted((json.loads(p.read_text()) for p in Path(sys.argv[1]).glob("*.json")),
            key=lambda d: -len(d["user"]))
order = ps + [ps[0]]
for d in order:
    r = httpx.post("http://localhost:11434/api/chat", timeout=600, json={
        "model": model, "stream": False, "think": False,
        "messages": [{"role": "system", "content": d["system"]}, {"role": "user", "content": d["user"]}],
        "options": {"num_predict": 1, "num_ctx": 16384, "temperature": 0}}).json()
    print(f'{d["name"]:45s} chars={len(d["system"])+len(d["user"]):6d} prompt_eval_count={r.get("prompt_eval_count")}')
