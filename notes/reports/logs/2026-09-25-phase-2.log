"""Live NHTSA regression set (ruling 2026-09-25): three failing vehicles + A4.
Prints result counts before (HEAD) and after (working tree) the resolver."""
import asyncio, importlib.util, subprocess, sys, tempfile
sys.path.insert(0, "/home/abrennan/cleardrive")
import knowledge as after
src = subprocess.run(["git", "-C", "/home/abrennan/cleardrive", "show", "HEAD:knowledge.py"], capture_output=True, text=True).stdout
f = tempfile.NamedTemporaryFile("w", suffix=".py", delete=False); f.write(src); f.close()
spec = importlib.util.spec_from_file_location("knowledge_before", f.name); before = importlib.util.module_from_spec(spec); spec.loader.exec_module(before)
CASES = [("Ford", "F-150", "2015"), ("Toyota", "Land Cruiser", "2014"), ("Audi", "A4 quattro", "2015"), ("Audi", "A4", "2015")]
async def main():
    for make, model, year in CASES:
        row = []
        for mod in (before, after):
            c = await mod.search_nhtsa(make, model, year); r = await mod.search_nhtsa_recalls(make, model, year)
            row.append(f"complaints={len(c)} recalls={len(r)}")
        print(f"{year} {make} {model!r:16s} BEFORE {row[0]:28s} AFTER {row[1]}")
asyncio.run(main())
