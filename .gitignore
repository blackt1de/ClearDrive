# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cache files
*.pyc
code_cache.json
vehicle_cache.json
forum_cache.json

# Database
*.db
cleardrive.db

# Backups (e.g. cleardrive.db.pre-research-logging.bak)
*.bak

# Scraped training data (regenerable via scrape_training_data.py)
training_data/

# ml/ — large/regenerable artifacts. .gitkeep files are kept so the
# directories exist on clone (negation patterns below).
ml/runs/*
!ml/runs/.gitkeep
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep
ml/data/pairs/*
!ml/data/pairs/.gitkeep
# Brief 2 training outputs (adapters, merged weights, GGUF); logs are committed.
ml/out/*
!ml/out/train_log.jsonl
!ml/out/train_stdout.log
!ml/out/pilot_log.jsonl
!ml/out/pilot_stdout.log

# Secrets
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
.git-scrub-replacements.txt

# Headless smoke-run artifacts (scripts/smoke_run.py)
/runs/

# Unsloth runtime kernel cache (regenerated on import)
unsloth_compiled_cache/

# Brief 2c distillation: venv and large/regenerable artifacts stay local; the manifest,
# counts, exclusions, synthesis prompt and reports are committed.
.venv-distill/
data/train/*
!data/train/MANIFEST.json
!data/train/exclusions.json
!data/train/synthesis_prompt.txt
!data/train/normalize_counts.json
!data/train/sample_composition.json
!data/train/filter_report.json
!data/train/synthesis_cost.json
